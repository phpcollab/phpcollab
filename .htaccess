# Deny access to the vendor subdirectory
RedirectMatch 403 ^/vendor/?$

# Set the level of error reporting to E_ALL (32767)
php_value error_reporting 32767

# Set the maximum depth that xdebug will display when var_dump() is called
php_value xdebug.var_display_max_depth 5

# Set the maximum number of children that xdebug will display when var_dump() is called
php_value xdebug.var_display_max_children 256

# Set the maximum amount of data (in bytes) that xdebug will display when var_dump() is called
php_value xdebug.var_display_max_data 3000

# Enable the display of errors
php_value display_errors 1

# Enable the logging of errors
php_value log_errors 1

# Set the maximum length of an error message. 0 means no limit
php_value log_errors_max_len 0

# Specify the path to the error log file
php_value error_log ./logs/php_errors.log

# Disable the use of transparent session IDs
php_value session.use_trans_sid 0

# Deny access to the PHP error log file
<Files php_errors.log>
 Order allow,deny
 Deny from all
 Satisfy All
</Files>

# ============================================================================
# URL Rewriting for Pretty URLs (Optional - Progressive Enhancement)
# ============================================================================
# If mod_rewrite is available, enable pretty URLs (/tasks/edit/123)
# If not available, fallback to PATH_INFO (/index.php/tasks/edit/123)
# Legacy direct file access still works (/tasks/edittask.php?id=123)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set the base for rewrites (adjust if installed in subdirectory)
    RewriteBase /

    # Allow direct access to existing files (CSS, JS, images, existing .php files)
    # This maintains backward compatibility with legacy URLs
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through index.php
    # This enables pretty URLs like /tasks/edit/123
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Note: If mod_rewrite is not available, URLs will use PATH_INFO format:
# /index.php/tasks/edit/123 instead of /tasks/edit/123
# The Router class handles both formats automatically.
