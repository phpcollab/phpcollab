msgid "setup_mkdirMethod"
msgstr "If safe-mode is On, you need to set a Ftp account to be able to createfolder with file management."

msgid "setup_notifications"
msgstr "Users e-mail notifications (task assignment, new post, taskchanges...)<br/>Valid smtp/sendmail needed."

msgid "setup_forcedlogin"
msgstr "If false, disallow external link with login/password in url"

msgid "setup_langdefault"
msgstr "Choose language to be selected on login by default or leave blank touse auto_detect browser language."

msgid "setup_myprefix"
msgstr "Set this value if you have tables with same name in existingdatabase.<br/><br/>assignments<br/>bookmarks<br/>bookmarks_categories<br/>calendar<br/>files<br/>logs<br/>members<br/>notes<br/>notifications<br/>organizations<br/>phases<br/>posts<br/>projects<br/>reports<br/>sorting<br/>subtasks<br/>support_posts<br/>support_requests<br/>tasks<br/>teams<br/>topics<br/>updates<br/><br/>Leaveblank for not use table prefix."

msgid "setup_loginmethod"
msgstr "Method to store passwords in database.<br/>Set to &quot;Crypt&quot; inorder htaccess authentificationto work (if htaccessauthentificationare enabled)."

msgid "admin_update"
msgstr "Respect strictly the order indicated to update your version<br/>1.Edit settings (supplement the new parameters)<br/>2. Edit database(update in agreement with your preceding version)"

msgid "task_scope_creep"
msgstr "Difference in days between due date and complete date (bold ifpositive)"

msgid "max_file_size"
msgstr "Maximum file size of a file to upload"

msgid "project_disk_space"
msgstr "Total size of files for the project"

msgid "project_scope_creep"
msgstr "Difference in days between due date and complete date (bold ifpositive). Total for all tasks"

msgid "mycompany_logo"
msgstr "Upload any logo of your company. Appears in header, instead of titlesite"

msgid "calendar_shortname"
msgstr "Label to appear in monthly calendar view. Mandatory"

msgid "user_autologout"
msgstr "Time in sec. to be disconnected after no activity. 0 to disable"

msgid "user_timezone"
msgstr "Set your GMT timezone"

msgid "setup_clientsfilter"
msgstr "Filter to see only logged user clients"

msgid "setup_projectsfilter"
msgstr "Filter to see only the project when the user are in the team"

msgid "setup_notificationMethod"
msgstr "Set method to send email notifications: with internal php mailfunction (need for having a smtp server or sendmail configured in theparameters of php) or with a personalized smtp server"

