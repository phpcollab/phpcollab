msgid "setup_mkdirMethod"
msgstr ""
"If safe-mode is On, you need to set a Ftp account to be able to create"
"folder with file management."

msgid "setup_notifications"
msgstr ""
"Users e-mail notifications (task assignment, new post, task"
"changes...)<br/>Valid smtp/sendmail needed."

msgid "setup_forcedlogin"
msgstr "If false, disallow external link with login/password in url"

msgid "setup_langdefault"
msgstr ""
"Choose language to be selected on login by default or leave blank to"
"use auto_detect browser language."

msgid "setup_myprefix"
msgstr ""
"Set this value if you have tables with same name in existing"
"database.<br/><br/>assignments<br/>bookmarks<br/>bookmarks_categories<br/>calendar<br/>files<br/>logs<br/>members<br/>notes<br/>notifications<br/>organizations<br/>phases<br/>posts<br/>projects<br/>reports<br/>sorting<br/>subtasks<br/>support_posts<br/>support_requests<br/>tasks<br/>teams<br/>topics<br/>updates<br/><br/>Leave"
"blank for not use table prefix."

msgid "setup_loginmethod"
msgstr ""
"Method to store passwords in database.<br/>Set to &quot;Crypt&quot; in"
"order htaccess authentificationto work (if htaccess"
"authentificationare enabled)."

msgid "admin_update"
msgstr ""
"Respect strictly the order indicated to update your version<br/>1."
"Edit settings (supplement the new parameters)<br/>2. Edit database"
"(update in agreement with your preceding version)"

msgid "task_scope_creep"
msgstr ""
"Difference in days between due date and complete date (bold if"
"positive)"

msgid "max_file_size"
msgstr "Maximum file size of a file to upload"

msgid "project_disk_space"
msgstr "Total size of files for the project"

msgid "project_scope_creep"
msgstr ""
"Difference in days between due date and complete date (bold if"
"positive). Total for all tasks"

msgid "mycompany_logo"
msgstr ""
"Upload any logo of your company. Appears in header, instead of title"
"site"

msgid "calendar_shortname"
msgstr "Label to appear in monthly calendar view. Mandatory"

msgid "user_autologout"
msgstr "Time in sec. to be disconnected after no activity. 0 to disable"

msgid "user_timezone"
msgstr "Set your GMT timezone"

msgid "setup_clientsfilter"
msgstr "Filter to see only logged user clients"

msgid "setup_projectsfilter"
msgstr "Filter to see only the project when the user are in the team"

msgid "setup_notificationMethod"
msgstr ""
"Set method to send email notifications: with internal php mail"
"function (need for having a smtp server or sendmail configured in the"
"parameters of php) or with a personalized smtp server"

msgid "newsdesk_links"
msgstr "to add multiple links use semicolon"

msgid "setup_error_database_server"
msgstr "You must enter the database Server"

msgid "setup_error_database_login"
msgstr "Must be insert the database Login"

msgid "setup_error_database_name"
msgstr "Must be insert the database Name"

msgid "setup_error_site_url"
msgstr "Must be insert the Root path"

msgid "setup_error_admin_password"
msgstr "Must insert an Admin password"

msgid "setup_error_admin_email"
msgstr "Must insert an Admin email"

msgid "setup_error_database"
msgstr ""
"Error connecting to database.  Please check that your information is"
"correct and try again."

msgid "setup_general_error"
msgstr "We had a problem completing the request. Please check and try again."

msgid "setup_success"
msgstr ""
"<p><strong>phpCollab has successfully been"
"installed.</strong></p><p><a href=\"%s\">Please log in</a></p>"

